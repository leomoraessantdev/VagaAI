GROQ_API_KEY=your_groq_api_key_here
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,https://your-vagaai.vercel.app
NODE_ENV=development

# Modelo da Groq. A Groq aposenta modelos sem aviso; se a geração começar a
# falhar com 'modelo indisponível', troque aqui em vez de mexer no código.
# Padrão: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
